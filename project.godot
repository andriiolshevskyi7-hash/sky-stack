; Engine configuration file.
; Sky Stack - 2.5D sprite-stacked fighter-jet game (Godot 4.3, GDScript)

config_version=5

[application]

config/name="Sky Stack"
config/description="Defend the city in a sprite-stacked pixel-art fighter jet."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/save.gd"
Stacks="*res://scripts/stack_lib.gd"
Sfx="*res://scripts/sfx.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1344
window/size/viewport_height=648
window/handheld/orientation=4
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true

[shader_globals]

night={
"type": "float",
"value": 0.0
}
ambient={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
sun_shift={
"type": "vec2",
"value": Vector2(0.35, 0.55)
}
jet_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
jet_yaw={
"type": "float",
"value": 0.0
}
jet_shadow_size={
"type": "float",
"value": 32.0
}
jet_shadow_tex={
"type": "sampler2D",
"value": ""
}
cloud_tex={
"type": "sampler2D",
"value": ""
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow={
"type": "float",
"value": 0.3
}
sprite_snap={
"type": "float",
"value": 0.0
}
island_tex={
"type": "sampler2D",
"value": ""
}
cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
fog_far={
"type": "float",
"value": 0.0
}
fog_color={
"type": "vec3",
"value": Vector3(0.7, 0.85, 1)
}
cloud_cover={
"type": "float",
"value": 0.62
}
fade_radius={
"type": "float",
"value": 26.0
}
