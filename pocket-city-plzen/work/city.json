 "notes": [
  {
   "title": "Náměstí Republiky",
   "text": "The rectangular square measures 139 × 193 m, one of the largest in Europe and the largest medieval square in Bohemia outside Prague. Trams run along its north and south sides. Since 2008 it has been paved with red-brown Italian porphyry instead of asphalt.",
   "links": [
    {
     "label": "Wikipedia (cs)",
     "url": "https://cs.wikipedia.org/wiki/N%C3%A1m%C4%9Bst%C3%AD_Republiky_(Plze%C5%88)"
    },
    {
     "label": "archiweb / ČTK",
     "url": "https://www.archiweb.cz/en/n/home/plzen-zahajila-prvni-etapu-revitalizace-namesti-vysazi-se-stromy-ubydou-auta"
    }
   ]
  },
  {
   "title": "Katedrála svatého Bartoloměje",
   "text": "A Gothic hall church with three naves, begun after 1342: 58 m long and 30 m wide, with vaults 25 m high. Its north tower, 102.26 m, is the tallest church tower in the country; the south tower was never finished and stops under the main cornice. The walls are cut sandstone and the saddle roof dates from 1528. The Šternberk chapel (hipped roof) adjoins the presbytery on the south, the sacristy (lean-to roof) on the north. The spire's shape and colours are drawn by eye.",
   "links": [
    {
     "label": "Wikipedia (cs)",
     "url": "https://cs.wikipedia.org/wiki/Katedr%C3%A1la_svat%C3%A9ho_Bartolom%C4%9Bje"
    }
   ]
  },
  {
   "title": "Town Hall and Císařský dům",
   "text": "The first Renaissance building in Plzeň, rebuilt by Giovanni de Statia of Lugano. Jan Koula designed its sgraffito decoration in 1910. Next door, Císařský dům joined two Renaissance houses in 1606–07 under twin gables. The gables, turret and sgraffito are drawn by eye.",
   "links": [
    {
     "label": "Wikipedia (cs), Town Hall",
     "url": "https://cs.wikipedia.org/wiki/Plze%C5%88sk%C3%A1_radnice"
    },
    {
     "label": "Wikipedia (cs), Císařský dům",
     "url": "https://cs.wikipedia.org/wiki/C%C3%ADsa%C5%99sk%C3%BD_d%C5%AFm_(Plze%C5%88)"
    }
   ]
  },
  {
   "title": "Marian plague column and gilded fountains",
   "text": "The early-Baroque column of 1681 stands in the north-west corner. It has a balustrade and six steps, and a copy of the Plzeň Madonna faces east. Since 2010, three gilded fountains by Ondřej Císler, a greyhound, a camel and an angel, stand in the other corners. Their shapes here are simplified.",
   "links": [
    {
     "label": "Wikipedia (cs), column",
     "url": "https://cs.wikipedia.org/wiki/Mari%C3%A1nsk%C3%BD_sloup_(Plze%C5%88)"
    },
    {
     "label": "Wikipedia (cs), square",
     "url": "https://cs.wikipedia.org/wiki/N%C3%A1m%C4%9Bst%C3%AD_Republiky_(Plze%C5%88)"
    }
   ]
  },
  {
   "title": "The 2026 elms",
   "text": "In 2026 the city began revitalising the square. The street between the cathedral and the bishop's residence becomes a walking and cycling zone, and 14 elms line about 250 m of the square's edge. The trees' exact spots here are illustrative.",
   "links": [
    {
     "label": "archiweb / ČTK",
     "url": "https://www.archiweb.cz/en/n/home/plzen-zahajila-prvni-etapu-revitalizace-namesti-vysazi-se-stromy-ubydou-auta"
    }
   ]
  },
  {
   "title": "What is illustrative",
   "text": "Measured from OpenStreetMap: footprints, streets, tram tracks, fountain spots and the cathedral's outline. Drawn by eye: most house heights (59 of 131 have none mapped), wall and roof colours, the cathedral's window tracery and spire, the Town Hall's gables, the Christmas stalls and tree, people and traffic. OpenStreetMap may not yet show every street change from the 2026 works.",
   "links": [
    {
     "label": "OpenStreetMap",
     "url": "https://www.openstreetmap.org/#map=18/49.7475/13.3778"
    }
   ]
  }
 ],
