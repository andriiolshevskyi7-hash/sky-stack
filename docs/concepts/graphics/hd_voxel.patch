+## Scale2x (EPX): doubles a pixel-art image, keeping hard edges and
+## turning staircase diagonals into finer steps.
+static func scale2x(src: Image) -> Image:
+	src.convert(Image.FORMAT_RGBA8)
+	var w := src.get_width()
+	var h := src.get_height()
+	var a := src.get_data().to_int32_array()
+	var o := PackedInt32Array()
+	o.resize(w * h * 4)
+	var w2 := w * 2
+	for y in h:
+		var ym := maxi(y - 1, 0) * w
+		var yp := mini(y + 1, h - 1) * w
+		var yc := y * w
+		for x in w:
+			var p := a[yc + x]
+			var t := a[ym + x]
+			var b := a[yp + x]
+			var l := a[yc + maxi(x - 1, 0)]
+			var r := a[yc + mini(x + 1, w - 1)]
+			var e0 := p
+			var e1 := p
+			var e2 := p
+			var e3 := p
+			if t != b and l != r:
+				if l == t:
+					e0 = l
+				if t == r:
+					e1 = r
+				if l == b:
+					e2 = l
+				if b == r:
+					e3 = r
+			var i0 := (y * 2) * w2 + x * 2
+			o[i0] = e0
+			o[i0 + 1] = e1
+			o[i0 + w2] = e2
+			o[i0 + w2 + 1] = e3
+	return Image.create_from_data(w2, h * 2, false, Image.FORMAT_RGBA8, o.to_byte_array())
 
 
