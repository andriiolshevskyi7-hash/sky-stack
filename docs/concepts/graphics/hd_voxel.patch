+## HD prototype: art parameters are in pixels of the 64 px model; scale them
+## to the finer grid (fin cant is px per slice: unchanged; "sec" is an exponent).
+static func _scale_art(a: Dictionary) -> Dictionary:
+	var o := {}
+	for k in a:
+		if k == "sec":
+			o[k] = a[k]
+		elif k == "fins":
+			var fl: Array = []
+			for f: Array in a[k]:
+				var g: Array = _scale_v(f)
+				g[1] = f[1]
+				fl.append(g)
+			o[k] = fl
+		else:
+			o[k] = _scale_v(a[k])
+	return o
+
+
+static func _scale_v(v: Variant) -> Variant:
+	if v is int:
+		return int(v) * int(HD_K)
+	if v is float:
+		return float(v) * HD_K
+	if v is Array:
+		var out: Array = []
+		for e in v:
+			out.append(_scale_v(e))
+		return out
+	return v
+
+
