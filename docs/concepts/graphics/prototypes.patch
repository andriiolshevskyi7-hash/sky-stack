@@ -19,6 +19,7 @@ global uniform sampler2D island_tex;
 global uniform vec3 cam_pos;
 global uniform float fog_far;
 global uniform vec3 fog_color;
+global uniform float demo;
 
 const vec3 SHADOW_TINT = vec3(0.42, 0.55, 0.88);
 
@@ -75,6 +76,12 @@ vec3 lit(vec3 col, vec3 w) {
 vec3 fogged(vec3 col, vec3 w) {
 	if (fog_far <= 0.0) return col;
 	float d = distance(w, cam_pos);
+	if (demo > 0.5 && demo < 1.5) {
+		// aerial perspective: blue haze that builds up with distance
+		float a = 1.0 - exp(-d / (fog_far * 0.38));
+		col = mix(col, col * vec3(0.82, 0.9, 1.05), clamp(d / 1500.0, 0.0, 1.0) * 0.5);
+		return mix(col, fog_color * vec3(0.95, 0.98, 1.04), clamp(a * 0.95, 0.0, 0.95));
+	}
 	return mix(col, fog_color, 0.9 * smoothstep(fog_far * 0.3, fog_far, d));
 }
 
@@ -116,6 +123,23 @@ bool fade_hides(vec3 view_pos, mat4 view_m, vec2 frag) {
 // sun glints where the sun reflects towards the camera (medium+ quality).
 vec3 water_light(vec3 col, vec3 w, vec2 p) {
 	if (gfx_quality < 0.5) return col;
+	if (demo > 2.5 && demo < 3.5) {
+		// sky reflection with wave normals, wide glittering sun path
+		vec3 v = normalize(cam_pos - w);
+		vec2 q = w.xz * 0.045;
+		float wn = sin(q.x * 1.3 + TIME * 1.4) * 0.5 + sin(q.y * 1.7 - TIME * 1.1) * 0.5 + (hash12(floor(w.xz / 2.0)) - 0.5) * 0.6;
+		vec3 n = normalize(vec3(wn * 0.09, 1.0, cos(q.x * 0.9 + q.y * 1.2 + TIME) * 0.07));
+		float fres = pow(1.0 - clamp(dot(v, n), 0.0, 1.0), 3.0);
+		vec3 skyc = mix(fog_color * 1.08, fog_color * vec3(0.7, 0.85, 1.1), clamp(-reflect(-v, n).y * 0.0 + 0.3, 0.0, 1.0));
+		col = mix(col * 0.85, skyc, clamp(0.15 + fres * 0.85, 0.0, 0.9) * (1.0 - night * 0.5));
+		vec3 sd = normalize(vec3(-sun_shift.x, 1.0, -sun_shift.y));
+		vec3 r = reflect(-v, n);
+		float sp = max(dot(r, sd), 0.0);
+		float tw = step(0.55, hash12(floor(p / 2.0) + floor(TIME * 6.0)));
+		col += vec3(1.0, 0.86, 0.62) * pow(sp, 40.0) * tw * 3.0 * (1.0 - night);
+		col += vec3(1.0, 0.85, 0.65) * pow(sp, 6.0) * 0.25 * (1.0 - night);
+		return col;
+	}
 	vec3 v = normalize(cam_pos - w);
 	float fres = pow(1.0 - clamp(v.y, 0.0, 1.0), 4.0);
 	col = mix(col, fog_color * 1.05, fres * 0.5 * (1.0 - night * 0.5));
