diff --git a/shaders/sky.gdshader b/shaders/sky.gdshader
index 7091839..78bc6d4 100644
--- a/shaders/sky.gdshader
+++ b/shaders/sky.gdshader
@@ -9,6 +9,38 @@ uniform float night = 0.0;
 uniform float sun_amount = 1.0;
 uniform vec3 sun_dir = vec3(-0.5, 0.5, -0.7);
 uniform vec3 moon_dir = vec3(0.45, 0.45, -0.75);
+global uniform float demo;
+
+float h3(vec3 p) {
+	p = fract(p * 0.3183099 + 0.1);
+	p *= 17.0;
+	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
+}
+float n3(vec3 x) {
+	vec3 i = floor(x);
+	vec3 f = fract(x);
+	f = f * f * (3.0 - 2.0 * f);
+	return mix(mix(mix(h3(i), h3(i + vec3(1, 0, 0)), f.x), mix(h3(i + vec3(0, 1, 0)), h3(i + vec3(1, 1, 0)), f.x), f.y),
+		mix(mix(h3(i + vec3(0, 0, 1)), h3(i + vec3(1, 0, 1)), f.x), mix(h3(i + vec3(0, 1, 1)), h3(i + vec3(1, 1, 1)), f.x), f.y), f.z);
+}
+float fbm(vec3 p) {
+	float a = 0.5;
+	float v = 0.0;
+	for (int i = 0; i < 5; i++) {
+		v += a * n3(p);
+		p = p * 2.03 + vec3(1.7, 9.2, 3.1);
+		a *= 0.5;
+	}
+	return v;
+}
+float cdens(vec3 p) {
+	float h = clamp((p.y - 1100.0) / 900.0, 0.0, 1.0);
+	// flat bases, rounded tops (cumulus)
+	float shape = smoothstep(0.0, 0.06, h) * smoothstep(1.0, 0.3, h);
+	float cov = n3(p * 0.00035);
+	float n = fbm(p * vec3(0.0016, 0.0022, 0.0016));
+	return clamp((n - 0.6 + cov * 0.16 - (1.0 - shape) * 0.3) * 5.0, 0.0, 1.0);
+}
 
 void sky() {
 	vec3 d = EYEDIR;
@@ -30,5 +62,38 @@ void sky() {
 	float sd = dot(d, normalize(sun_dir));
 	c += vec3(1.0, 0.75, 0.45) * pow(max(sd, 0.0), 120.0) * sun_amount * 0.6;
 	if (sd > 0.9993) c = mix(c, vec3(1.0, 0.95, 0.8), sun_amount);
+	if (demo > 0.5 && demo < 1.5) {
+		// atmosphere: deeper blue overhead, bright hazy band and a wide
+		// sun halo (Mie)
+		c = mix(c, c * vec3(0.78, 0.9, 1.12), smoothstep(0.1, 0.8, y));
+		c += vec3(1.0, 0.85, 0.65) * pow(max(sd, 0.0), 6.0) * 0.1 * sun_amount;
+		c += vec3(0.9, 0.95, 1.0) * exp(-abs(y) * 14.0) * 0.05;
+		// volumetric clouds: ray-march a cloud layer 700..1600 m
+		if (d.y > 0.02) {
+			float t0 = max((1100.0 - POSITION.y) / d.y, 0.0);
+			float t1 = min((2000.0 - POSITION.y) / d.y, t0 + 6000.0);
+			float tr = 1.0;
+			vec3 acc = vec3(0.0);
+			vec3 sdn = normalize(sun_dir);
+			float stp = (t1 - t0) / 40.0;
+			for (int i = 0; i < 40; i++) {
+				if (tr < 0.02) break;
+				vec3 p = POSITION + d * (t0 + (float(i) + 0.5) * stp);
+				float den = cdens(p);
+				if (den > 0.01) {
+					float ls = cdens(p + sdn * 90.0) + cdens(p + sdn * 260.0) * 0.6;
+					float light = exp(-ls * 2.2);
+					float hgt = clamp((p.y - 1100.0) / 900.0, 0.0, 1.0);
+					vec3 col = mix(vec3(0.62, 0.68, 0.8), vec3(1.05, 1.02, 0.97), light) * (0.85 + 0.25 * hgt);
+					col += vec3(1.0, 0.8, 0.6) * pow(max(sd, 0.0), 4.0) * light * 0.35;
+					float a = 1.0 - exp(-den * stp * 0.02);
+					acc += col * a * tr;
+					tr *= 1.0 - a;
+				}
+			}
+			float far = smoothstep(6000.0, 18000.0, t0);
+			c = mix(c * tr + acc, c, far);
+		}
+	}
 	COLOR = c;
 }
